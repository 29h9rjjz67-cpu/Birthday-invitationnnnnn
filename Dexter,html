<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Moosa's Birthday Mission ❤️</title>

<script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.3/dist/confetti.browser.min.js"></script>

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial,sans-serif;
}

body{
background:#f8f5ef;
overflow-x:hidden;
}

/* PAGE 1 */

#page1{
height:100vh;
display:flex;
flex-direction:column;
justify-content:center;
align-items:center;
text-align:center;
padding:20px;
}

#page1 h1{
font-size:2.2rem;
color:#1358c8;
max-width:600px;
}

.buttons{
margin-top:35px;
}

button{
cursor:pointer;
border:none;
border-radius:15px;
padding:15px 30px;
font-size:22px;
transition:.3s;
}

#yes{
background:#1358c8;
color:white;
}

#no{
background:white;
border:2px solid #1358c8;
position:absolute;
}

#message{
margin-top:25px;
color:#1358c8;
font-weight:bold;
font-size:1.1rem;
}

/* PAGE 2 */

#page2{
display:none;
min-height:100vh;
padding:40px 20px;
text-align:center;
background:#f8f5ef;
}

.invited{
letter-spacing:6px;
font-size:18px;
margin-top:20px;
}

.name{
font-size:4rem;
color:#1358c8;
font-family:cursive;
margin-top:40px;
}

.birthday{
font-size:5rem;
font-weight:bold;
color:#1358c8;
}

.hearts{
font-size:40px;
margin-top:10px;
}

.info{
margin-top:60px;
line-height:1.8;
font-size:1.3rem;
}

.date{
font-size:2.3rem;
font-weight:bold;
color:#1358c8;
margin-top:20px;
}

.location{
font-size:2.3rem;
font-weight:bold;
color:#1358c8;
margin-top:10px;
}

#countdown{
margin-top:25px;
color:#1358c8;
}

.cake{
font-size:120px;
margin-top:40px;
}

/* FLOATING HEARTS */

.heart{
position:fixed;
font-size:25px;
animation:float 12s linear infinite;
pointer-events:none;
}

.h1{left:10%;}
.h2{left:30%;animation-delay:2s;}
.h3{left:50%;animation-delay:4s;}
.h4{left:70%;animation-delay:6s;}
.h5{left:90%;animation-delay:8s;}

@keyframes float{
from{
transform:translateY(100vh);
opacity:0;
}
20%{
opacity:1;
}
to{
transform:translateY(-120vh);
opacity:0;
}
}

</style>
</head>

<body>

<!-- FLOATING HEARTS -->

<div class="heart h1">💙</div>
<div class="heart h2">🤍</div>
<div class="heart h3">💙</div>
<div class="heart h4">🤍</div>
<div class="heart h5">💙</div>

<!-- PAGE 1 -->

<div id="page1">

<h1>
Msmoosti ❤️<br><br>
Will you spend your birthday with me?
</h1>

<div class="buttons">
<button id="yes">YES ❤️</button>
<button id="no">NO 💔</button>
</div>

<p id="message"></p>

</div>

<!-- PAGE 2 -->

<div id="page2">

<p class="invited">YOU'RE INVITED TO</p>

<div class="name">Moosa's</div>

<div class="birthday">BIRTHDAY</div>

<div class="hearts">♡ &nbsp; ♡</div>

<div class="info">

<p>
NO NEED FOR A DRESS CODE CUZ<br>
EVERYTHING LOOKS SEXY ON MY MAN 😌
</p>

<div class="date">
JUNE 6 2026
</div>

<p>
1:00 PM – 9:00 PM
</p>

<div class="location">
ALKHABURAH
</div>

<h2 id="countdown"></h2>

</div>

<div class="cake">🎂</div>

<p style="margin-top:30px;font-size:22px;">
Reward Includes:<br>
🍰 Cake<br>
🍕 Food<br>
💋 Kisses<br>
❤️ A very clingy girlfriend
</p>

</div>

<script>

const yesBtn = document.getElementById("yes");
const noBtn = document.getElementById("no");
const message = document.getElementById("message");

const texts = [
"Are you sure? 🥺",
"Really sure? 😔",
"Think carefully 😤",
"Wrong answer 😌",
"Try again 😭",
"Bro just press YES",
"The birthday committee says no.",
"Your vote has been ignored.",
"You have no free will here.",
"MSMOOSTI PRESS YES ❤️"
];

let counter = 0;

function moveButton(){

const x = Math.random() * (window.innerWidth - 150);
const y = Math.random() * (window.innerHeight - 100);

noBtn.style.left = x + "px";
noBtn.style.top = y + "px";

message.innerText = texts[counter % texts.length];

counter++;

let size = parseInt(window.getComputedStyle(yesBtn).fontSize);

yesBtn.style.fontSize = (size + 4) + "px";
yesBtn.style.padding = "18px 36px";
}

noBtn.addEventListener("mouseover", moveButton);
noBtn.addEventListener("click", moveButton);

yesBtn.addEventListener("click", () => {

confetti({
particleCount:250,
spread:120,
origin:{y:0.6}
});

document.getElementById("page1").style.display="none";
document.getElementById("page2").style.display="block";

});

const birthdayDate = new Date("June 6, 2026 13:00:00");

setInterval(() => {

const now = new Date();
const difference = birthdayDate - now;

const days = Math.floor(difference / (1000 * 60 * 60 * 24));

const countdown = document.getElementById("countdown");

if(countdown){
countdown.innerText =
"⏳ " + days + " days until the Birthday Mission";
}

},1000);

</script>

</body>
</html>
